[BlueFerry Plugin]
Id=io.weirdware.blueferry.webdav
Name=WebDAV files
Version=0.1.2
ApiVersion=1.2
MinBlueFerry=0.8
Capabilities=card;share;notify;
Homepage=https://github.com/joshii-h/blueferry-plugin-webdav
Source=https://github.com/joshii-h/blueferry-plugin-webdav
Exec=blueferry-webdav serve
Cli=blueferry-webdav
Alias=webdav

[Config url]
Label=WebDAV address
Type=string
Required=true
Help=Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/ - SFTPGo or other: https://dav.example.org/

[Config username]
Label=User name
Type=string
Required=true

[Config password]
Label=Password or app password
Type=secret
Required=true
Help=For Nextcloud create an app password under Settings > Security

[Config folder]
Label=Target folder
Type=string
Default=BlueFerry
Help=Created on the server if missing, for example BlueFerry or Phone/Uploads

[Config public_link]
Label=Create a public link (Nextcloud only)
Type=bool
Default=false
Help=After an upload, share the file by link through Nextcloud's sharing API

[Config max_size_mb]
Label=Size limit per file (MB)
Type=int
Default=2048
Min=1
Max=102400

[Config allow_http_lan]
Label=Allow plain http on the local network
Type=bool
Default=false
Help=Only for servers in your LAN; passwords then travel unencrypted. http to localhost always works

[Config web_url]
Label=Web address of the folder (optional)
Type=url
Help=Opened by "Open folder" for servers other than Nextcloud, for example the SFTPGo web client
